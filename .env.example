# --- TELEGRAM DASHBOARD CONFIGURATION ---

# The token for your Master Hub Bot (from @BotFather)
DASHBOARD_BOT_TOKEN=

# Comma-separated Telegram IDs allowed to access the Hub
ADMIN_IDS=

# A secret token to secure Hub-Agent communication
HUB_SECRET=super_secret_token_123

# Port the dashboard will run on
PORT=7860

# --- MTPROTO (Sync with BotFather) ---
# Get these from https://my.telegram.org
API_ID=
API_HASH=
